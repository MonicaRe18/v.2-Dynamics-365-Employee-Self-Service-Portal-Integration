# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Microsoft Dynamics 365 Finance & Operations / HR Backend Configuration
# Kept exclusively on backend environment variables (React only calls the ASP.NET Core backend proxy)
D365Settings__BaseUrl=""
D365Settings__TenantId=""
D365Settings__ClientId=""
D365Settings__ClientSecret=""
D365Settings__ResourceUrl=""
D365Settings__LegalEntity=""
D365Settings__UseDemoMode="false"
D365Settings__TimeoutSeconds="30"
# Relative path of the PAR_Assignment custom service supplied with this project.
D365Settings__ReassignmentEndpointPath="/api/services/PAR_EssAssignmentServiceGroup/PAR_EssAssignmentService/submitAssignment"

# JWT Token Security Settings (Server-side)
JwtSettings__SecretKey="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
JwtSettings__ExpirationMinutes="120"
